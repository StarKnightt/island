 "version": 1,
 "units": "metres, glTF Y-up, scale 1",
 "material_note": "all kits share one palette (dark grey basalt, weathered planes, rust stains, grey-green lichen); albedo is de-lit; ORM = R ambient occlusion, G roughness, B metalness 0",
 "kits": {
  "cliff": {
   "file": "cliff_kit.glb",
   "material": "rock_cliff",
   "textures": {
    "albedo": "2048 sRGB KTX2",
    "normal": "2048 OpenGL KTX2",
    "orm": "2048 KTX2 (R AO, G roughness, B 0)"
   },
   "notes": "faces look toward +Z, width along X, base line at y = 0 with a skirt down to y = -4.5 to sink into sea bed / terrain; back (-Z) and top are open shells; the left/right ends bend back (-Z) and are lower than the middle, so a taller overlapping neighbour hides the cut edges"
  },
  "stack": {
   "file": "stacks.glb",
   "material": "rock_stack",
   "textures": {
    "albedo": "2048 sRGB KTX2",
    "normal": "2048 OpenGL KTX2",
    "orm": "2048 KTX2 (R AO, G roughness, B 0)"
   },
   "notes": "free-standing closed single-sided meshes, origin at the centre of the base footprint, y = 0 is the base (geometry continues ~1-1.7 m below it); sink each stack by its waterline_y (4.6-5 m at scale 1, times the scale) so the wave-cut notch sits at the sea surface; the notch is deepest on the +Z side (face it toward the open sea / swell); stack_b has a sea arch through its foot (about 4.5 m wide, open from the waterline to ~8 m); tops are rough and ledged for shrubs"
  },
  "boulder": {
   "file": "boulders.glb",
   "material": "rock_boulder",
   "textures": {
    "albedo": "2048 sRGB KTX2",
    "normal": "2048 OpenGL KTX2",
    "orm": "2048 KTX2 (R AO, G roughness, B 0)"
   },
   "notes": "closed single-sided meshes; origin at the centre of the footprint at the ground line: the part below y = 0 (the 'bury' fraction of the height) is meant to be inside the terrain / sand / water; granite_* use a lighter grey to rust-tan granite palette, basalt_* and pebbles_a / pebbles_b the cliff-kit basalt palette, pebbles_c the granite palette"
  },
  "shelf": {
   "file": "shelves.glb",
   "material": "rock_shelf",
   "textures": {
    "albedo": "2048 sRGB KTX2",
    "normal": "2048 OpenGL KTX2",
    "orm": "2048 KTX2 (R AO, G roughness, B 0)"
   },
   "notes": "low wave-cut basalt platforms, single-sided meshes open only at the bottom (z = floor, buried); origin at the centre of the footprint; y = 0 is the foot of the seaward wall; the seaward wall (with the wave-cut notch and the fallen blocks) faces +Z, the landward side (-Z) slopes down and is meant to be buried in the beach / terrain; sink each shelf so the sea surface sits at waterline_y (times the scale): the notch and the dark spray zone then sit at the water"
  }
 },
